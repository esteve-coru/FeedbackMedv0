# Copy this file to .env.local for local dev, and set the same value
# as an Environment Variable in Vercel for deployment.

# Supabase: Project Settings -> Database -> Connection string -> "Transaction" pooler (port 6543)
# It will look like:
# postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-2.pooler.supabase.com:6543/postgres
DATABASE_URL=
